{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Post migration job request",
  "javaType": "org.folio.rest.jaxrs.model.AsyncMigrationJobRequest",
  "type": "object",
  "properties": {
    "migrations": {
      "description": "Names of migration procedure",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affectedEntities": {
      "description": "List of affected entities by particular migration",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["INSTANCE", "ITEM"]
      }
    },
    "resume": {
      "description": "Continue a state-table migration from the last processed id even if it is marked as started",
      "type": "boolean",
      "default": false
    },
    "restart": {
      "description": "Reset the progress of a state-table migration and start from the beginning",
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ]
}
