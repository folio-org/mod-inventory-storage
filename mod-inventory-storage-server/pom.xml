    <artifactId>mod-inventory-storage</artifactId>
    <version>31.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mod-inventory-storage-server</artifactId>

  <dependencies>
    <!-- Dependencies -->
    <dependency>
      <groupId>org.folio</groupId>
      <artifactId>mod-inventory-storage-dto</artifactId>
